# Скопируй этот файл в .env и впиши свои ключи.
# .env в git не попадает (см. .gitignore).

# --- Вариант Б (рекомендуемый): один ключ на все модели ---
OPENROUTER_API_KEY=

# --- Прямые провайдеры (если есть доступ и карта) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- РФ-контур (152-ФЗ) ---
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# --- Локально (Ollama) ---
OLLAMA_HOST=http://localhost:11434
